  m_EditorClassIdentifier: Assembly-CSharp::GamePlay.Questions.VerbalQuestion
  questionText: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0647\u0648\u0627\u064A\u0629
    \u0623\u0648 \u0627\u0644\u0639\u0627\u062F\u0629 \u0627\u0644\u062A\u064A \u0643\u0627\u0646
    \u064A\u0645\u0627\u0631\u0633\u0647\u0627 \u0627\u0644\u0633\u0628\u0648\u0639\u064A
    \u0648\u062A\u063A\u0636\u0628 \u0633\u0644\u064A\u0645\u0627\u0646 \u062F\u0627\u0626\u0645\u0627\u064B\u061F"
  voiceClip: {fileID: 0}
  difficulty: 0
  correctAnswer: "\u0627\u0644\u0623\u0643\u0644 \u0627\u0644\u0645\u0641\u0631\u0637
    (\u062E\u0627\u0635\u0629 \"\u0627\u0644\u0643\u0633\u0643\u0633\u064A\" \u0623\u0648
    \"\u0627\u0644\u0644\u0628\u0644\u0627\u0628\u064A\")."
  correctAnswerVoice: {fileID: 0}
