  m_EditorClassIdentifier: Assembly-CSharp::GamePlay.Questions.VerbalQuestion
  questionText: "\u0645\u0646 \u0647\u064A \u0627\u0644\u0634\u062E\u0635\u064A\u0629
    \u0627\u0644\u062A\u064A \u0643\u0627\u0646\u062A \u062A\u0634\u0631\u0641 \u0639\u0644\u0649
